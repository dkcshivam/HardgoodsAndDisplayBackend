# Copy to .env. Docker compose reads this file too, for the values below.
# Running without it uses the defaults in docker-compose.yml.

# Docker compose substitutes variables in this file, so a literal $ in any
# value must be written as $$ or compose will silently eat it. Django's own
# get_random_secret_key() can emit a $, so this generator avoids one:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=

# Postgres reads the password below only when it first creates the database.
# Changing it later needs `docker compose down -v`, which wipes the data.
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

POSTGRES_DB=dkc_packing
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Where the frontend runs. The browser is blocked without this.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Photos go to this private S3 bucket, in development too; uploads fail
# without it. DEPLOY.md has the IAM policy the keys need.
AWS_STORAGE_BUCKET_NAME=
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
