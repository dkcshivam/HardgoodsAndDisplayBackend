# Copy to .env. Docker compose reads this file too, for the values below.
# Running without it uses the defaults in docker-compose.yml.

# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

POSTGRES_DB=dkc_packing
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Where the frontend runs. The browser is blocked without this.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
